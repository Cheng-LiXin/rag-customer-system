# 复制为 application-local.yml（已被 .gitignore 忽略），或用 IDEA 运行配置注入环境变量。
# 不要把真实密钥提交进 Git。

spring:
  datasource:
    username: root
    password: 123456
  data:
    redis:
      password:

pgvector:
  datasource:
    username: postgres
    password: postgres

jwt:
  # 本地开发用 HS256 密钥，长度 >= 32 字符；生产请用随机值
  secret: local-dev-only-change-me-0123456789abcdef

# AI Key 也可写在这里（推荐仍用环境变量）：
# spring:
#   ai:
#     openai:
#       api-key: sk-xxxx
#       embedding:
#         api-key: sk-xxxx
