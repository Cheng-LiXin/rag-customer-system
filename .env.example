# =============================================================================
# Docker Compose 部署环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制为 .env 后填真实值（.env 已在 .gitignore 中，不会被提交）
#   cp .env.example .env
#
# ★ 全栈一键起：
#   docker compose --profile full up -d --build
#   然后访问 http://localhost:8081
#
# ★ 只起依赖（本机 IDEA / 命令行跑后端时用，与改动前行为一致）：
#   docker compose up -d
# =============================================================================

# ---------- 宿主机端口映射 ----------
# Web 入口刻意避开 8080：Windows 上 8080 常被 winnat 排除端口占用，
# 自查命令：netsh interface ipv4 show excludedportrange protocol=tcp
WEB_PORT=8081

# MySQL 映射到 3307 而非 3306：本机通常已装 MySQL 占着 3306（本项目原本就是本机 MySQL）。
# 容器内部仍走 mysql:3306，不受影响。
MYSQL_PORT=3307

# 可观测性（批次 F）。后端指标端口 9091 **不映射到宿主机**，只由 Prometheus 在容器网络内抓取。
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Grafana 管理员密码（用户名固定 admin）
GRAFANA_PASSWORD=admin123

# ---------- MySQL（业务库）----------
MYSQL_ROOT_PASSWORD=123456
# 应用连接用的账号口令（与上面保持一致最简单；容器部署下 root 也够用）
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ---------- PostgreSQL / PGVector（向量库）----------
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# ---------- Redis（缓存 + 人工客服协调）----------
# 留空 = 无密码。容器网络内且不对公网暴露，本地/内网演示够用；
# 若部署到公网服务器，请设密码并把 6379 从安全组里去掉。
REDIS_PASSWORD=

# ---------- 应用密钥（★ 必填，否则登录/问答会失败）----------
# JWT HS256 密钥，长度必须 >= 32 字符。生产环境请用随机值：
#   openssl rand -base64 48
JWT_SECRET=local-dev-only-change-me-0123456789abcdef

# AI Key：Chat 用 DeepSeek，Embedding 用 SiliconFlow（DeepSeek 官方无 Embedding 接口）
DEEPSEEK_API_KEY=sk-deepseek-xxx
SILICONFLOW_API_KEY=sk-siliconflow-xxx

# ---------- 演示账号口令 ----------
# 改掉这三个就不用怕"默认口令写在仓库里"。注意两点：
#   ① 它们只在**首次建号**时生效；账号已存在时不会被改动
#      （容器侧 DEMO_RESET_PASSWORDS 默认 false，正是为了不覆盖你后来改的口令）
#   ② 里面已有账号时，改 .env 不会改库里的口令 —— 那要在应用里改
#      （登录 → 个人信息 → 账号安全 → 修改密码），或直接改库
DEMO_ADMIN_PASSWORD=Admin@Ysu2026
DEMO_AGENT_PASSWORD=Agent@Ysu2026
DEMO_USER_PASSWORD=User@Ysu2026
# 置 true 会在**每次启动**把上面三个账号的口令重置成这里的值 —— 仅供本地开发
DEMO_RESET_PASSWORDS=false
